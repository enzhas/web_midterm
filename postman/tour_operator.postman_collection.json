            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/bookings/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tour\": {{tour_id}},\n  \"customer_name\": \"Aida Karimova\",\n  \"customer_email\": \"aida@example.com\",\n  \"guests\": 2,\n  \"status\": \"pending\",\n  \"notes\": \"Vegetarian lunch please.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"booking_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List bookings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/bookings/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
