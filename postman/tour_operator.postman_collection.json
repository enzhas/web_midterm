        "url": "{{base_url}}/api/bookings/{{booking_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tour\": {{tour_id}},\n  \"customer_name\": \"Aida Karimova\",\n  \"customer_email\": \"aida@example.com\",\n  \"guests\": 2,\n  \"status\": \"confirmed\",\n  \"notes\": \"Vegetarian lunch please.\"\n}",
          "options": {
