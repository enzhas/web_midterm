{
  "info": {
    "name": "Tour Operator API",
    "description": "Run all requests in order. Create requests save IDs automatically; final requests clean up demo records. Local coursework API, no authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8001"
    },
    {
      "key": "tour_id",
      "value": ""
    },
    {
      "key": "booking_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "API root",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Database health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/health/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create tour",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/tours/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Charyn Canyon Adventure\",\n  \"destination\": \"Kazakhstan, Charyn Canyon\",\n  \"description\": \"Guided canyon walk with transport from Almaty.\",\n  \"price\": \"149.00\",\n  \"start_date\": \"2027-06-10\",\n  \"end_date\": \"2027-06-12\",\n  \"max_guests\": 12,\n  \"is_active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"tour_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List tours",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tours/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get tour",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tours/{{tour_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Replace tour (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/tours/{{tour_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Charyn Canyon Adventure\",\n  \"destination\": \"Kazakhstan, Charyn Canyon\",\n  \"description\": \"Guided canyon walk with transport from Almaty.\",\n  \"price\": \"159.00\",\n  \"start_date\": \"2027-06-10\",\n  \"end_date\": \"2027-06-12\",\n  \"max_guests\": 12,\n  \"is_active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update tour (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/tours/{{tour_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated itinerary with a picnic.\"\n}",
          "options": {
            "raw": {
