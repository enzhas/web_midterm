    },
    {
      "name": "Protected tour deletion",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/tours/{{tour_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid tour dates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/tours/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Charyn Canyon Adventure\",\n  \"destination\": \"Kazakhstan, Charyn Canyon\",\n  \"description\": \"Guided canyon walk with transport from Almaty.\",\n  \"price\": \"149.00\",\n  \"start_date\": \"2027-06-10\",\n  \"end_date\": \"2027-06-01\",\n  \"max_guests\": 12,\n  \"is_active\": true\n}",
          "options": {
